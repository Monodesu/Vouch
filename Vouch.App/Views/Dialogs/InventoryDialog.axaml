<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:steam="using:Vouch.Core.Steam"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.InventoryDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="480" IsVisible="{Binding ShowInventory}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dlgTitle" Text="{loc:T Detail_Inventory}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Background="Transparent"
                        Foreground="{DynamicResource TextLo}" Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- opt into a hand-typed appid for games not in the "games with items" list -->
            <CheckBox IsChecked="{Binding InvUseCustom}" Content="{loc:T Transfer_Custom}"
                      Foreground="{DynamicResource TextHi}" />

            <!-- games with items (only these; count shown), like Steam's inventory dropdown -->
            <ComboBox HorizontalAlignment="Stretch"
                      IsVisible="{Binding !InvUseCustom}"
                      ItemsSource="{Binding InventoryApps}" SelectedItem="{Binding SelectedInventoryApp}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="steam:InventoryApp">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding AssetCount, StringFormat='({0})'}"
                                       Foreground="{DynamicResource TextLo}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- custom appid / context + load -->
            <Grid IsVisible="{Binding InvUseCustom}" ColumnDefinitions="*,8,90,8,Auto">
                <TextBox Grid.Column="0" Text="{Binding InvCustomAppId}"
                         PlaceholderText="{loc:T Transfer_CustomAppPh}" />
                <TextBox Grid.Column="2" Text="{Binding InvCustomContextId}"
                         PlaceholderText="{loc:T Transfer_CustomCtxPh}" />
                <Button Grid.Column="4" Classes="ghost" Command="{Binding LoadCustomInventoryCommand}"
                        IsEnabled="{Binding !InventoryBusy}">
                    <Panel>
                        <TextBlock Text="{loc:T Transfer_Load}" IsVisible="{Binding !InventoryBusy}" />
                        <TextBlock Text="{loc:T Transfer_Loading}" IsVisible="{Binding InventoryBusy}" />
                    </Panel>
                </Button>
            </Grid>

            <!-- item grid (read-only): a wrap of icon tiles; hover for the name -->
            <Border Background="{DynamicResource InputBg}" CornerRadius="8" Padding="8" MinHeight="160" MaxHeight="440">
                <Panel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InventoryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransferItem">
                                    <Border Width="58" Height="58" Margin="3" CornerRadius="6"
                                            Background="{DynamicResource Card}" ToolTip.Tip="{Binding Name}">
                                        <Image Source="{Binding Image}" Width="52" Height="52" Stretch="Uniform" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- status / loading / empty overlay -->
                    <TextBlock Text="{Binding InventoryStatus}"
                               IsVisible="{Binding InventoryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextLo}" FontSize="12" TextWrapping="Wrap"
                               MaxWidth="380" TextAlignment="Center" />
                </Panel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{loc:T Common_Close}" Command="{Binding CloseDialogsCommand}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
