<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.WizardDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="500" IsVisible="{Binding WizardBodyVisible}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="dlgTitle" Text="{loc:T Wizard_Title}" />
                    <TextBlock Text="{loc:T Wizard_Intro}"
                               Foreground="{DynamicResource TextLo}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Background="Transparent"
                        Foreground="{DynamicResource TextLo}" VerticalAlignment="Top"
                        Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <!-- step 1: login -->
            <StackPanel Spacing="12" IsVisible="{Binding WizardOnStep1}">
                <StackPanel Spacing="6">
                    <TextBlock Classes="dlgLabel" Text="{loc:T Wizard_Username}" />
                    <TextBox Text="{Binding WizardUsername}" PlaceholderText="{loc:T Wizard_UsernamePh}" />
                </StackPanel>
                <StackPanel Spacing="6">
                    <TextBlock Classes="dlgLabel" Text="{loc:T Wizard_Password}" />
                    <TextBox Text="{Binding WizardPassword}" PasswordChar="•" PlaceholderText="{loc:T Wizard_PasswordPh}" />
                </StackPanel>

                <Border Background="{DynamicResource CardHi}" CornerRadius="8" Padding="12,10">
                    <TextBlock Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap"
                               Text="{loc:T Wizard_LoginHint}" />
                </Border>
            </StackPanel>

            <!-- step 2: add + verify a phone (accounts with no phone) -->
            <StackPanel Spacing="12" IsVisible="{Binding WizardOnStep2}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding WizardShowSendPhone}">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Classes="dlgLabel" Text="{loc:T Wizard_PhoneNumber}" />
                        <TextBox Text="{Binding WizardPhoneNumber}" PlaceholderText="+15551234567" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" Width="80">
                        <TextBlock Classes="dlgLabel" Text="{loc:T Wizard_Country}" />
                        <TextBox Text="{Binding WizardPhoneCountry}" PlaceholderText="US" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="6" IsVisible="{Binding WizardShowVerifyPhone}">
                    <TextBlock Classes="dlgLabel" Text="{loc:T Wizard_PhoneSms}" />
                    <TextBox Text="{Binding WizardPhoneSmsCode}" PlaceholderText="{loc:T Wizard_PhoneSmsPh}" />
                </StackPanel>
                <Border Background="{DynamicResource CardHi}" CornerRadius="8" Padding="12,10">
                    <TextBlock Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap"
                               Text="{loc:T Wizard_PhoneHint}" />
                </Border>
            </StackPanel>

            <!-- step 3: revocation code + SMS finalize -->
            <StackPanel Spacing="12" IsVisible="{Binding WizardOnStep3}">
                <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10">
                    <TextBlock Foreground="{DynamicResource WarnText}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                               Text="{loc:T Wizard_RevocationWarn}" />
                </Border>
                <Border Background="{DynamicResource InputBg}" CornerRadius="10" Padding="18">
                    <TextBlock Text="{Binding WizardRevocationCode}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextHi}" FontSize="28" FontWeight="Bold"
                               FontFamily="Cascadia Mono,Consolas,monospace" />
                </Border>
                <TextBlock Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap"
                           Text="{loc:T Wizard_RevocationHint}" />
            </StackPanel>

            <TextBlock Text="{Binding WizardStatus}" Foreground="{DynamicResource TextHi}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding WizardStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- footer -->
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0" Classes="ghost" Content="{loc:T Common_Cancel}"
                        Command="{Binding CloseDialogsCommand}" />
                <Button Grid.Column="2" Classes="primary" IsVisible="{Binding WizardOnStep1}"
                        Command="{Binding WizardLoginAndAddCommand}">
                    <Panel>
                        <TextBlock Text="{loc:T Wizard_LoginContinue}" IsVisible="{Binding !WizardBusy}" />
                        <TextBlock Text="{loc:T Wizard_Working}" IsVisible="{Binding WizardBusy}" />
                    </Panel>
                </Button>
                <!-- step 2: send email (before) / continue (after) -->
                <Button Grid.Column="2" Classes="primary"
                        IsVisible="{Binding WizardShowSendPhone}" Command="{Binding WizardSendPhoneEmailCommand}">
                    <Panel>
                        <TextBlock Text="{loc:T Wizard_SendConfirmation}" IsVisible="{Binding !WizardBusy}" />
                        <TextBlock Text="{loc:T Wizard_Sending}" IsVisible="{Binding WizardBusy}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2" Classes="primary"
                        IsVisible="{Binding WizardShowContinuePhone}" Command="{Binding WizardContinueAfterEmailCommand}">
                    <Panel>
                        <TextBlock Text="{loc:T Wizard_ClickedContinue}" IsVisible="{Binding !WizardBusy}" />
                        <TextBlock Text="{loc:T Wizard_Checking}" IsVisible="{Binding WizardBusy}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2" Classes="primary"
                        IsVisible="{Binding WizardShowVerifyPhone}" Command="{Binding WizardVerifyPhoneCommand}">
                    <Panel>
                        <TextBlock Text="{loc:T Wizard_VerifyPhone}" IsVisible="{Binding !WizardBusy}" />
                        <TextBlock Text="{loc:T Wizard_Verifying}" IsVisible="{Binding WizardBusy}" />
                    </Panel>
                </Button>
                <Button Grid.Column="2" Classes="primary" IsVisible="{Binding WizardOnStep3}"
                        Content="{loc:T Wizard_Continue}" Command="{Binding OpenFinalizePromptCommand}" />
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
