<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.LoginDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="440" IsVisible="{Binding ShowLogin}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="dlgTitle" Text="{loc:T Login_Title}" />
                    <TextBlock Text="{loc:T Login_Sub}"
                               Foreground="{DynamicResource TextLo}" FontSize="12" />
                    <TextBlock Text="{Binding BatchSignInProgress}" IsVisible="{Binding BatchSignInActive}"
                               Foreground="{DynamicResource Accent}" FontSize="11.5" FontWeight="SemiBold"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Background="Transparent" VerticalAlignment="Top"
                        Foreground="{DynamicResource TextLo}" Command="{Binding LoginCloseCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <StackPanel Spacing="6">
                <TextBlock Classes="dlgLabel" Text="{loc:T Common_UsernameLabel}" />
                <TextBox Text="{Binding LoginUsername}" PlaceholderText="{loc:T Common_UsernamePh}" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Classes="dlgLabel" Text="{loc:T Common_PasswordLabel}" />
                <TextBox Text="{Binding LoginPassword}" PasswordChar="•" PlaceholderText="{loc:T Common_PasswordPh}" />
            </StackPanel>

            <Border Background="{DynamicResource InputBg}" CornerRadius="8" Padding="12,9">
                <TextBlock Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap"
                           Text="{loc:T Login_Note}" />
            </Border>

            <!-- email code (only when Steam asks) -->
            <StackPanel Spacing="6" IsVisible="{Binding LoginNeedsEmail}">
                <TextBlock Classes="dlgLabel" Text="{loc:T Common_EmailCodeLabel}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding LoginEmailCode}" PlaceholderText="{loc:T Common_EmailCodePh}" />
                    <Button Grid.Column="1" Classes="ghost" Content="{loc:T Common_Submit}"
                            Command="{Binding SubmitEmailCodeCommand}" />
                </Grid>
            </StackPanel>

            <TextBlock Text="{Binding LoginStatus}" Foreground="{DynamicResource TextHi}"
                       FontSize="12" TextWrapping="Wrap"
                       IsVisible="{Binding LoginStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0" Classes="ghost" Content="{loc:T Common_Close}" HorizontalAlignment="Left"
                        Command="{Binding LoginCloseCommand}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Classes="ghost" Content="{loc:T Batch_SignInSkip}"
                            IsVisible="{Binding BatchSignInActive}" IsEnabled="{Binding !LoginBusy}"
                            Command="{Binding SkipBatchSignInCommand}" />
                    <Button Classes="primary" Command="{Binding DoLoginCommand}">
                        <Panel>
                            <TextBlock Text="{loc:T Login_Button}" IsVisible="{Binding !LoginBusy}" />
                            <TextBlock Text="{loc:T Login_Busy}" IsVisible="{Binding LoginBusy}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
