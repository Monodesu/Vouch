<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.LoginDetailDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="460" IsVisible="{Binding ShowLoginDetail}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,8,0">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Viewbox Grid.Column="0" Width="25" Height="25" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Ico_Laptop}" Fill="{DynamicResource TextHi}" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Classes="dlgTitle" Text="{loc:T Login_DetailTitle}" />
                    <TextBlock Text="{Binding DetailLogin.FriendlyDevice}" Foreground="{DynamicResource TextLo}" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Background="Transparent" VerticalAlignment="Top"
                        Foreground="{DynamicResource TextLo}" Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Background="{DynamicResource CardHi}" CornerRadius="10" Padding="14">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:T Login_Device}" Foreground="{DynamicResource AccentDim}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLogin.DeviceName}" Foreground="{DynamicResource TextHi}" FontSize="12.5" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:T Login_Location}" Foreground="{DynamicResource AccentDim}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLogin.Location}" Foreground="{DynamicResource TextHi}" FontSize="12.5" />
                        <Button Classes="rowlink" HorizontalAlignment="Left" IsVisible="{Binding HasDetailMap}"
                                Command="{Binding OpenLinkCommand}" CommandParameter="{Binding DetailLoginMapUrl}">
                            <TextBlock Text="{loc:T Login_ViewOnMap}" Foreground="{DynamicResource Accent}" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Text="{loc:T Login_IpAddress}" Foreground="{DynamicResource AccentDim}" FontSize="10.5" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DetailLogin.Ip}" Foreground="{DynamicResource TextHi}" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <CheckBox IsChecked="{Binding LoginDetailRemember}" Content="{loc:T Login_StaySignedIn}"
                      HorizontalAlignment="Left" Foreground="{DynamicResource TextHi}"
                      FocusAdorner="{x:Null}" />

            <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10">
                <TextBlock Text="{loc:T Login_ApprovalWarn}" Foreground="{DynamicResource WarnText}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{loc:T Common_Close}" Command="{Binding CloseDialogsCommand}" />
                <Button Classes="pill deny" Content="{loc:T Confirm_Deny}" Command="{Binding DenyLoginDetailCommand}" />
                <Button Classes="pill accept" Content="{loc:T Login_Approve}" Command="{Binding ApproveLoginDetailCommand}" />
            </StackPanel>

        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
