<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.DeactivateDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="440" IsVisible="{Binding ShowDeactivate}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dlgTitle" Text="{loc:T Deactivate_Title}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Background="Transparent"
                        Foreground="{DynamicResource TextLo}" Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10">
                <TextBlock Text="{loc:T Deactivate_Warn}" Foreground="{DynamicResource WarnText}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="{Binding DeactivateCountText}"
                       Foreground="{DynamicResource TextHi}" FontSize="13" />

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Deactivate_ToEmail}" Foreground="{DynamicResource TextHi}" />
                    <TextBlock Text="{loc:T Deactivate_ToEmailHint}" Foreground="{DynamicResource TextLo}"
                               FontSize="11.5" TextWrapping="Wrap" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DeactivateToEmail}" HorizontalAlignment="Right" />
            </Grid>

            <TextBlock Text="{Binding DeactivateStatus}" Foreground="{DynamicResource TextHi}" FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding DeactivateStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{loc:T Common_Cancel}" Command="{Binding CloseDialogsCommand}" />
                <Button Classes="pill deny" Padding="16,8" Command="{Binding DoDeactivateCommand}">
                    <Panel>
                        <TextBlock Text="{loc:T Deactivate_Btn}" IsVisible="{Binding !DeactivateBusy}" />
                        <TextBlock Text="{loc:T Deactivate_Working}" IsVisible="{Binding DeactivateBusy}" />
                    </Panel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
