<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.RemoveDialog"
             x:DataType="vm:MainViewModel">

    <Border Classes="dialog" Width="480" IsVisible="{Binding ShowRemove}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dlgTitle" Text="{loc:T Remove_Title}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Background="Transparent"
                        Foreground="{DynamicResource TextLo}" Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
            <StackPanel DataContext="{Binding SelectedAccount}" Spacing="2">
                <TextBlock Classes="dlgLabel" Text="{loc:T Common_AccountLabel}" />
                <TextBlock Text="{Binding PersonaName}" Foreground="{DynamicResource TextHi}" FontSize="15" />
                <TextBlock Text="{Binding SteamId}" Foreground="{DynamicResource TextLo}" FontSize="12" />
            </StackPanel>

            <StackPanel Spacing="10">
                <RadioButton GroupName="removeMode" IsChecked="{Binding RemoveModeAppOnly}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Remove_AppOnly}" Foreground="{DynamicResource TextHi}" />
                        <TextBlock Text="{loc:T Remove_AppOnlySub}"
                                   Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="removeMode" IsChecked="{Binding RemoveModeToEmail}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Remove_ToEmail}" Foreground="{DynamicResource TextHi}" />
                        <TextBlock Text="{loc:T Remove_ToEmailSub}"
                                   Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="removeMode" IsChecked="{Binding RemoveModeFull}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:T Remove_Full}" Foreground="{DynamicResource Bad}" />
                        <TextBlock Text="{loc:T Remove_FullSub}"
                                   Foreground="{DynamicResource TextLo}" FontSize="11.5" TextWrapping="Wrap" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding !RemoveModeAppOnly}">
                <TextBlock Classes="dlgLabel" Text="{loc:T Remove_RevocationLabel}" />
                <TextBox Text="{Binding RemoveRevocationCode}" PlaceholderText="R#####" FontFamily="Consolas,monospace" />
                <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10">
                    <TextBlock Foreground="{DynamicResource WarnText}" FontSize="12" TextWrapping="Wrap"
                               Text="{loc:T Remove_AttemptsWarn}" />
                </Border>
            </StackPanel>

            <TextBlock Text="{Binding RemoveStatus}" Foreground="{DynamicResource TextHi}" FontSize="12"
                       TextWrapping="Wrap"
                       IsVisible="{Binding RemoveStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{loc:T Common_Close}" Command="{Binding CloseDialogsCommand}" />
                <Button Classes="primary" Background="{DynamicResource Bad}" Foreground="White"
                        Content="{loc:T Remove_Button}" Command="{Binding RemoveAccountCommand}"
                        IsVisible="{Binding !RemoveDone}" IsEnabled="{Binding !RemoveBusy}" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
