<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vouch.App.ViewModels"
             xmlns:loc="using:Vouch.App.Localization"
             x:Class="Vouch.App.Views.Dialogs.TransferDialog"
             x:DataType="vm:MainViewModel">

    <UserControl.Styles>
        <!-- mode tabs: transfer all vs. pick items -->
        <Style Selector="Button.modetab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextLo}" />
            <Setter Property="Padding" Value="2,6" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.modetab.active">
            <Setter Property="Foreground" Value="{DynamicResource TextHi}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.modetab:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Border Classes="dialog" Width="450" IsVisible="{Binding ShowTransfer}"
            MaxHeight="{Binding $parent[Panel].Bounds.Height, Converter={StaticResource Subtract}, ConverterParameter=72}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="0,0,8,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="dlgTitle" Text="{loc:T Transfer_Title}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Background="Transparent"
                        Foreground="{DynamicResource TextLo}" Command="{Binding CloseDialogsCommand}">
                    <Viewbox Width="15" Height="15">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ico_Close}" Fill="{DynamicResource TextLo}" />
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>

            <TextBlock Text="{loc:T Transfer_Sub}" Foreground="{DynamicResource TextLo}"
                       FontSize="12.5" TextWrapping="Wrap" />

            <!-- no trade link configured -->
            <Border IsVisible="{Binding !HasTradeUrl}" Background="{DynamicResource WarnBg}"
                    CornerRadius="8" Padding="12,10">
                <TextBlock Text="{loc:T Transfer_SetUrlFirst}" Foreground="{DynamicResource WarnText}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="10" IsVisible="{Binding HasTradeUrl}">

                <!-- mode tabs: transfer all vs. pick items -->
                <StackPanel Orientation="Horizontal" Spacing="22">
                    <Button Classes="modetab" Classes.active="{Binding !TransferSelectMode}"
                            Content="{loc:T Transfer_TabAll}" Command="{Binding TransferModeAllCommand}" />
                    <Button Classes="modetab" Classes.active="{Binding TransferSelectMode}"
                            Content="{loc:T Transfer_TabPick}" Command="{Binding TransferModePickCommand}" />
                </StackPanel>

                <!-- ALL mode: pick games, send everything -->
                <StackPanel Spacing="6" IsVisible="{Binding !TransferSelectMode}">
                    <TextBlock Classes="dlgLabel" Text="{loc:T Transfer_Games}" />
                    <TextBlock Text="{loc:T Transfer_Loading}" IsVisible="{Binding TransferGamesLoading}"
                               Foreground="{DynamicResource TextLo}" FontSize="12" Margin="0,2" />
                    <ItemsControl ItemsSource="{Binding TransferGames}" IsVisible="{Binding !TransferGamesLoading}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TransferGame">
                                <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Name}"
                                          Foreground="{DynamicResource TextHi}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <CheckBox IsChecked="{Binding UseCustomAppId}" Content="{loc:T Transfer_Custom}"
                              Foreground="{DynamicResource TextHi}" Margin="0,1" />
                    <Grid ColumnDefinitions="*,8,90" IsVisible="{Binding UseCustomAppId}">
                        <TextBox Grid.Column="0" Text="{Binding CustomAppId}"
                                 PlaceholderText="{loc:T Transfer_CustomAppPh}" />
                        <TextBox Grid.Column="2" Text="{Binding CustomContextId}"
                                 PlaceholderText="{loc:T Transfer_CustomCtxPh}" />
                    </Grid>
                </StackPanel>

                <!-- SELECT mode: load a game's inventory, tick items -->
                <StackPanel Spacing="8" IsVisible="{Binding TransferSelectMode}">
                    <TextBlock Text="{loc:T Transfer_Loading}" IsVisible="{Binding TransferGamesLoading}"
                               Foreground="{DynamicResource TextLo}" FontSize="12" />
                    <CheckBox IsChecked="{Binding UseCustomAppId}" Content="{loc:T Transfer_Custom}"
                              Foreground="{DynamicResource TextHi}" />
                    <Grid ColumnDefinitions="*,8,Auto">
                        <!-- game picker, or custom appid/context inputs when the checkbox is ticked -->
                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                  IsVisible="{Binding !UseCustomAppId}"
                                  ItemsSource="{Binding TransferGames}" SelectedItem="{Binding SelectGame}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TransferGame">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Grid Grid.Column="0" IsVisible="{Binding UseCustomAppId}" ColumnDefinitions="*,8,90">
                            <TextBox Grid.Column="0" Text="{Binding CustomAppId}"
                                     PlaceholderText="{loc:T Transfer_CustomAppPh}" />
                            <TextBox Grid.Column="2" Text="{Binding CustomContextId}"
                                     PlaceholderText="{loc:T Transfer_CustomCtxPh}" />
                        </Grid>
                        <Button Grid.Column="2" Classes="ghost" Command="{Binding LoadInventoryCommand}"
                                IsEnabled="{Binding !LoadingInventory}">
                            <Panel>
                                <TextBlock Text="{loc:T Transfer_Load}" IsVisible="{Binding !LoadingInventory}" />
                                <TextBlock Text="{loc:T Transfer_Loading}" IsVisible="{Binding LoadingInventory}" />
                            </Panel>
                        </Button>
                    </Grid>
                    <Button Classes="ghost" Content="{loc:T Transfer_SelectAll}" HorizontalAlignment="Left"
                            Padding="10,5" FontSize="12" Command="{Binding ToggleSelectAllItemsCommand}" />
                    <Border Background="{DynamicResource InputBg}" CornerRadius="8" Padding="6" MaxHeight="200" MinHeight="56">
                        <Panel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InventoryItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TransferItem">
                                            <CheckBox IsChecked="{Binding IsSelected}" Foreground="{DynamicResource TextHi}" Margin="2,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                                                            Background="{DynamicResource Card}" VerticalAlignment="Center">
                                                        <Image Source="{Binding Image}" Width="28" Height="28" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{loc:T Transfer_NoItemsInInv}" IsVisible="{Binding HasNoInventory}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextLo}" FontSize="12" />
                        </Panel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <Border Background="{DynamicResource WarnBg}" CornerRadius="8" Padding="12,10"
                    IsVisible="{Binding HasTradeUrl}">
                <TextBlock Text="{loc:T Transfer_Warn}" Foreground="{DynamicResource WarnText}"
                           FontSize="12" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="{loc:T Common_Close}" Command="{Binding CloseDialogsCommand}" />
                <Button Classes="primary" Command="{Binding DoTransferCommand}"
                        IsEnabled="{Binding HasTradeUrl}">
                    <Panel>
                        <TextBlock Text="{loc:T Transfer_Send}" IsVisible="{Binding !TransferBusy}" />
                        <TextBlock Text="{loc:T Transfer_Sending}" IsVisible="{Binding TransferBusy}" />
                    </Panel>
                </Button>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
